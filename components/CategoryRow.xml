        <field id="itemContent" type="node" onChange="onContentChanged"/>
        <field id="focusPercent" type="float" onChange="updateFocus"/>
        <field id="listHasFocus" type="boolean" onChange="updateFocus"/>
    </interface>
    <script type="text/brightscript" uri="pkg:/components/CategoryRow.brs"/>
    <children>
        <Rectangle id="highlight" width="236" height="56" color="0x2E3140FF" opacity="0"/>
        <Rectangle id="accent" width="5" height="56" color="0xF5C518FF" opacity="0"/>
        <Label
            id="name"
            translation="[16,0]"
            width="160"
            height="56"
            vertAlign="center"
            wrap="false"
            color="0xC8CAD4FF"
            font="font:SmallestSystemFont"/>
        <Label
            id="count"
            translation="[176,0]"
            width="52"
            height="56"
            vertAlign="center"
            horizAlign="right"
            color="0x7C8091FF"
            font="font:SmallestSystemFont"/>
