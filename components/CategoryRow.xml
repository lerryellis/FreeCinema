<?xml version="1.0" encoding="utf-8"?>
<component name="CategoryRow" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContentChanged"/>
        <field id="focusPercent" type="float" onChange="updateFocus"/>
        <field id="listHasFocus" type="boolean" onChange="updateFocus"/>
    </interface>
    <script type="text/brightscript" uri="pkg:/components/CategoryRow.brs"/>
    <children>
        <Rectangle id="highlight" width="236" height="56" color="0xFFFFFF26" opacity="0"/>
        <Rectangle id="accent" width="5" height="56" color="0xFFFFFFFF" opacity="0"/>
        <Label
            id="name"
            translation="[16,0]"
            width="150"
            height="56"
            vertAlign="center"
            wrap="false"
            color="0xFFFFFFB3"
            font="font:SmallestSystemFont"/>
        <Label
            id="count"
            translation="[166,0]"
            width="62"
            height="56"
            vertAlign="center"
            horizAlign="right"
            color="0xFFFFFF73"
            font="font:SmallestSystemFont"/>
    </children>
</component>
