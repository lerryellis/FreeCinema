<?xml version="1.0" encoding="utf-8"?>
<component name="MainScene" extends="Scene">
    <script type="text/brightscript" uri="pkg:/components/Config.brs"/>
    <script type="text/brightscript" uri="pkg:/components/Favorites.brs"/>
    <script type="text/brightscript" uri="pkg:/components/MainScene.brs"/>
    <children>
        <Rectangle id="background" width="1920" height="1080" color="0x0E0F14FF"/>
        <Label
            id="header"
            translation="[90,40]"
            text="FreeCinema"
            color="0xF5C518FF"
            font="font:LargeBoldSystemFont"/>
        <Label
            id="hint"
            translation="[90,105]"
            width="1740"
            text="Press * for Search, Playlist URL and Reload"
            color="0xA0A3B1FF"
            font="font:SmallSystemFont"/>
        <RowList
            id="rowList"
            translation="[90,160]"
            itemComponentName="ChannelItem"
            numRows="3"
            itemSize="[1740,290]"
            itemSpacing="[0,20]"
            rowItemSize="[[300,230]]"
            rowItemSpacing="[[30,0]]"
            showRowLabel="[true]"
            rowLabelOffset="[[0,12]]"
            rowLabelColor="0xFFFFFFFF"
            rowLabelFont="font:MediumBoldSystemFont"
            rowFocusAnimationStyle="floatingFocus"
            vertFocusAnimationStyle="fixedFocus"
            visible="false"/>
        <Label
            id="status"
            translation="[90,480]"
            width="1740"
            horizAlign="center"
            wrap="true"
            color="0xFFFFFFFF"
            font="font:MediumSystemFont"/>
        <Video id="video" width="1920" height="1080" visible="false"/>
    </children>
</component>
